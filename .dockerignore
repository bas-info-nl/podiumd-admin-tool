# The build context is the repository root. Only what the Dockerfile copies is
# sent: the frontend and backend sources, without local build output.
*
!backend/
!frontend/

backend/.venv/
backend/tests/
frontend/node_modules/
frontend/dist/
frontend/coverage/
**/__pycache__/
**/*.py[cod]
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/.import_linter_cache/
**/.coverage
**/.coverage.*
**/coverage.xml
**/*.tsbuildinfo
**/.env
**/.env.*
**/.DS_Store
